AIRS_MYSQL_DATABASE=airs
AIRS_MYSQL_USER=airs_user
AIRS_MYSQL_PASSWORD=change-me-mysql-password
AIRS_MYSQL_ROOT_PASSWORD=change-me-mysql-root-password

AIRS_DDL_AUTO=update
AIRS_FLYWAY_ENABLED=true
AIRS_FLYWAY_BASELINE_ON_MIGRATE=true
AIRS_FLYWAY_BASELINE_VERSION=1

AIRS_JWT_SECRET_KEY=change-me-jwt-secret-key-at-least-32-bytes
AIRS_JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30

AIRS_CORS_ALLOWED_ORIGINS=*
AIRS_SERVER_PORT=8080

AIRS_INFLUX_USERNAME=airs_admin
AIRS_INFLUX_PASSWORD=change-me-influx-admin-password
AIRS_INFLUX_TOKEN=change-me-influx-token
AIRS_INFLUX_ORG=airs
AIRS_INFLUX_BUCKET=airs
AIRS_INFLUX_MEASUREMENT=sensor_data
AIRS_INFLUX_NODE_ID_TAG=node_id
AIRS_INFLUX_ROLLUP_BUCKET=airs_rollup
AIRS_INFLUX_ROLLUP_MEASUREMENT=sensor_rollup_1h

AIRS_MQTT_ENABLED=true
AIRS_MQTT_HOST=mosquitto
AIRS_MQTT_PORT=1883
AIRS_MQTT_TOPIC=airs/node/+/telemetry

AIRS_OCCUPANCY_STALE_AFTER_MINUTES=10
AIRS_OCCUPANCY_INFLUX_WRITE_ENABLED=false

AIRS_AI_EVALUATION_SCHEDULER_ENABLED=true
AIRS_AI_EVALUATION_SCHEDULER_INITIAL_DELAY_MS=60000
AIRS_AI_EVALUATION_SCHEDULER_FIXED_DELAY_MS=600000

# Redis cache: shared by every Spring instance and safe to rebuild from InfluxDB.
AIRS_REDIS_HOST=redis
AIRS_REDIS_PORT=6379
AIRS_REDIS_CONNECT_TIMEOUT=500ms
AIRS_REDIS_TIMEOUT=500ms
AIRS_ANALYTICS_CACHE_ENABLED=true

# CO2 analysis graph cache: today stays fresh; historical dates are immutable enough to reuse longer.
AIRS_ANALYTICS_TREND_TODAY_TTL_SECONDS=30
AIRS_ANALYTICS_TREND_HISTORY_TTL_SECONDS=1800
AIRS_ANALYTICS_TREND_CACHE_KEY_PREFIX=airs:analytics:co2-trend:v1

AIRS_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
